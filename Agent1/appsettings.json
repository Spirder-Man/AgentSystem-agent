{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning",
        "Microsoft.SemanticKernel": "Information"
      }
    },
    "Enrich": ["WithMachineName", "WithThreadId"],
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/agent1-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u3}] {MachineName} RunId={RunId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Llm": {
    "ModelId": "qwen3:8b",
    "Endpoint": "http://localhost:11434",
    "MultimodalModelId": "qwen-vl:latest",
    "FunctionCallingModelId": "qwen3:8b",
    "MaxRetries": 3,
    "RetryDelayMs": 1000,
    "BufferFlushThreshold": 50,
    "CircuitBreakerThreshold": 3
  },
  "KnowledgeBase": {
    "BasePath": "d:\\桌面\\agent\\项目\\Agent1\\knowledgebase",
    "Sources": [
      { "Name": "国标", "Path": "国标", "Priority": 100 },
      { "Name": "园区规则", "Path": "园区规则", "Priority": 80 },
      { "Name": "历史案例", "Path": "历史案例", "Priority": 60 }
    ],
    "ChunkSize": 500,
    "ChunkOverlap": 100,
    "EnableSemanticChunking": true,
    "EnableQueryExpansion": true,
    "QueryCacheTtlMinutes": 5,
    "QueryCacheMaxEntries": 500,
    "SearchMode": "Hybrid"
  },
  "VectorSearch": {
    "EnableVectorSearch": true,
    "EmbeddingModelId": "nomic-embed-text:latest",
    "EmbeddingEndpoint": "http://localhost:8081/v1",
    "EmbeddingDimension": 768,
    "Bm25Weight": 0.4,
    "VectorWeight": 0.6,
    "IndexType": "hnsw",
    "HnswM": 16,
    "HnswEfConstruction": 200,
    "HnswEfSearch": 64,
    "GpuEmbeddingEnabled": true,
    "GpuSearchEnabled": true,
    "RerankerEnabled": true,
    "GpuFallbackEnabled": true,
    "EmbeddingBatchSize": 32,
    "EmbeddingTimeoutSeconds": 30,
    "MaxConcurrentEmbeddings": 4,
    "RerankerEndpoint": "http://localhost:8082/rerank",
    "RerankerModelId": "bge-reranker-v2-m3",
    "RerankerCandidateTopK": 20,
    "RerankerFinalTopK": 5
  },
  "Database": {
    "Provider": "PostgreSQL",
    "Host": "localhost",
    "Port": 5432,
    "DatabaseName": "chemical_park_ai_agent",
    "Username": "postgres",
    "Password": "",
    "ConnectionTimeout": 10,
    "MaxPoolSize": 50
  },
  "Integration": {
    "EnableERPSync": false,
    "EnableWMSSync": false,
    "EnableEHSSync": false,
    "ERPApiBaseUrl": "",
    "WMSApiBaseUrl": "",
    "EHSApiBaseUrl": ""
  },
  "ChemicalTool": {
    "Tools": [
      { "Name": "CheckHazardCategory",   "Description": "查询危化品危险类别及适用国标",   "KeywordTriggers": ["类别", "分类", "属于", "国标", "GB"] },
      { "Name": "CheckStorageCompatibility", "Description": "检查两种危险化学品是否可以在同一仓库中储存，用于判断同库储存合规性。当用户询问两种化学品能否放在一起、共存、同库存放时，必须调用此工具", "KeywordTriggers": ["同库", "共存", "混合", "禁忌", "配伍", "储存冲突", "同一仓库", "放在一起", "相邻存放", "共库", "一起存放", "同库存放", "能否同存"] },
      { "Name": "GetSafetyDistance",      "Description": "查询设施间安全间距要求",        "KeywordTriggers": ["安全距离", "间距", "消防通道", "储罐间距", "防火间距"] },
      { "Name": "GetCurrentTime",         "Description": "获取当前时间",                   "KeywordTriggers": ["时间", "几点", "日期"] },
      { "Name": "Calculate",              "Description": "数学计算",                       "KeywordTriggers": ["计算", "等于"] }
    ]
  },
  "Audit": {
    "EnableOperationLog": true,
    "AuditLogRetentionDays": 180,
    "EnableDataEncryption": true
  },
  "Alerting": {
    "Enabled": true,
    "Email": {
      "Enabled": true,
      "SmtpHost": "smtp.qq.com",
      "SmtpPort": 587,
      "SenderEmail": "2732232706@qq.com",
      "SenderPassword": "",
      "RecipientEmails": []
    }
  },
  "Auth": {
    "Accounts": [
      { "Username": "admin", "Password": "", "Role": "admin" },
      { "Username": "auditor", "Password": "", "Role": "auditor" },
      { "Username": "viewer", "Password": "", "Role": "viewer" }
    ]
  },
  "Jwt": {
    "Key": "",
    "Issuer": "Agent1",
    "Audience": "Agent1.Api",
    "ExpireHours": 8
  },
  "Evaluation": {
    "EvalSetPath": "Data/ComplianceEvalSet.json",
    "CaseIntervalMs": 500,
    "OutputReportPath": "Data/eval_report.json"
  },
  "PromptTemplates": {
    "SystemRole": "你是化工园区危化品合规审核专家。",
    "SimpleChatRole": "你是友好的AI助手，名字叫{AssistantName}。",
    "OutputTemplate": "请严格按以下模板输出（每项一行，不要多余内容）：\n【合规判断】是/否\n【法规依据】引用具体标准编号+条款\n【违规点】若无违规写「无」\n【整改建议】若无违规则写「无需整改」",
    "HistoryTemplate": "对话历史：\n{History}",
    "CurrentQuestionTemplate": "【当前问题】{UserInput}",
    "SimpleChatQuestionTemplate": "用户说：{UserInput}\n\n用户的名字可能是{UserName}。\n\n请直接回答用户，不要思考标记。",
    "EvalFastPrompt": "{SystemRole}\n\n【强制工具调用指令】回答前必须调用至少一个可用的函数工具获取数据。严禁跳过工具直接凭记忆回答。\n\n【反幻觉指令】法规编号必须严格引用工具返回中 [REGULATIONS: ...] 的值，不得自行编造任何 GB XXXX-XXXX 格式的编号。如果工具未返回 [REGULATIONS: ...] 标签，则不得编造任何法规编号。\n\n【输出格式】每条查询结果用一句话概括，禁止输出法规全文。只提取关键结论，不要复制粘贴整段原文。\n\n【当前问题】{UserInput}\n\n获取工具数据后，严格按以下模板输出（每项一行，不要多余内容）：\n【合规判断】是/否\n【法规依据】引用具体标准编号+条款\n【违规点】若无违规写「无」\n【整改建议】若无违规则写「无需整改」\n\n回答末尾必须附加判定标签（独立一行）：[判定:is_compliant=true] 或 [判定:is_compliant=false]",
    "EvalFastQueryPrompt": "{SystemRole}\n\n【输出格式】每条查询结果用一句话概括，禁止输出法规全文。只提取关键信息，不要复制粘贴整段原文。\n\n【当前问题（信息查询，仅提取事实，禁止做合规判断）】{UserInput}\n\n请仅提取并输出与该问题相关的具体信息（如数值、类别、法规编号等），不要主动判断是否合规。\n输出格式：\n【查询结果】直接给出具体信息内容（一句话概括）\n【法规依据】引用具体标准编号+条款（如有）\n\n回答末尾必须附加判定标签（独立一行）：[判定:is_compliant=依据原文]"
  }
}
