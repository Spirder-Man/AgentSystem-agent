{
  "Llm": {
    "ModelId": "qwen3:8b-eval",
    "Endpoint": "http://localhost:11434",
    "MultimodalModelId": "qwen-vl:latest",
    "FunctionCallingModelId": "qwen3:8b-eval",
    "MaxRetries": 3,
    "RetryDelayMs": 1000,
    "BufferFlushThreshold": 50
  },
  "KnowledgeBase": {
    "BasePath": "d:\\桌面\\agent\\项目\\Agent1\\knowledgebase",
    "Sources": [
      { "Name": "国标", "Path": "国标", "Priority": 100 },
      { "Name": "园区规则", "Path": "园区规则", "Priority": 80 },
      { "Name": "历史案例", "Path": "历史案例", "Priority": 60 }
    ],
    "ChunkSize": 500,
    "SearchMode": "Hybrid"
  },
  "VectorSearch": {
    "EnableVectorSearch": true,
    "EmbeddingModelId": "nomic-embed-text:latest",
    "EmbeddingDimension": 768,
    "Bm25Weight": 0.4,
    "VectorWeight": 0.6,
    "IndexType": "hnsw",
    "HnswM": 16,
    "HnswEfConstruction": 200,
    "HnswEfSearch": 64
  },
  "Database": {
    "Provider": "PostgreSQL",
    "Host": "localhost",
    "Port": 5432,
    "DatabaseName": "chemical_park_ai_agent",
    "Username": "postgres",
    "Password": "",
    "ConnectionTimeout": 30,
    "MaxPoolSize": 20
  },
  "Integration": {
    "EnableERPSync": false,
    "EnableWMSSync": false,
    "EnableEHSSync": false,
    "ERPApiBaseUrl": "",
    "WMSApiBaseUrl": "",
    "EHSApiBaseUrl": ""
  },
  "ChemicalTool": {
    "Tools": [
      { "Name": "CheckHazardCategory",   "Description": "查询危化品危险类别及适用国标",   "KeywordTriggers": ["类别", "分类", "属于", "国标", "GB"] },
      { "Name": "CheckStorageCompatibility", "Description": "检查两种危化品是否可同库储存", "KeywordTriggers": ["同库", "共存", "混合", "禁忌", "配伍", "储存冲突"] },
      { "Name": "GetSafetyDistance",      "Description": "查询设施间安全间距要求",        "KeywordTriggers": ["安全距离", "间距", "消防通道", "储罐间距", "防火间距"] },
      { "Name": "GetCurrentTime",         "Description": "获取当前时间",                   "KeywordTriggers": ["时间", "几点", "日期"] },
      { "Name": "Calculate",              "Description": "数学计算",                       "KeywordTriggers": ["计算", "等于"] }
    ]
  },
  "Audit": {
    "EnableOperationLog": true,
    "AuditLogRetentionDays": 180,
    "EnableDataEncryption": true
  },
  "Evaluation": {
    "EvalSetPath": "Data/ComplianceEvalSet.json",
    "CaseIntervalMs": 500,
    "OutputReportPath": "Data/eval_report.json"
  },
  "PromptTemplates": {
    "SystemRole": "你是化工园区危化品合规审核专家。",
    "SimpleChatRole": "你是友好的AI助手，名字叫{AssistantName}。",
    "OutputTemplate": "请严格按以下模板输出（每项一行，不要多余内容）：\n【合规判断】是/否\n【法规依据】引用具体标准编号+条款\n【违规点】若无违规写「无」\n【整改建议】若无违规则写「无需整改」",
    "HistoryTemplate": "对话历史：\n{History}",
    "CurrentQuestionTemplate": "【当前问题】{UserInput}",
    "SimpleChatQuestionTemplate": "用户说：{UserInput}\n\n用户的名字可能是{UserName}。\n\n请直接回答用户，不要思考标记。",
    "EvalFastPrompt": "{SystemRole}\n\n【当前问题】{UserInput}\n\n请严格按以下模板输出（每项一行，不要多余内容）：\n【合规判断】是/否\n【法规依据】引用具体标准编号+条款\n【违规点】若无违规写「无」\n【整改建议】若无违规则写「无需整改」"
  }
}
