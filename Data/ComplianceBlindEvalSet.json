{
  "name": "化工合规AI Agent独立盲测集 — 零失误架构泛化能力基准",
  "version": "1.0",
  "created": "2026-06-27",
  "description": "独立盲测集，设计原则: (1)50%化学品不在当前数据库覆盖范围内 (2)4级难度分层 (3)覆盖GB30000全系列 (4)验证系统泛化与拒绝能力",
  "test_cases": [
    {
      "id": "BL01",
      "category": "危险类别查询",
      "difficulty": "L1",
      "intent": "info_query",
      "query": "甲苯属于什么危险类别？",
      "expected_tool": "CheckHazardCategory",
      "expected_params": { "chemicalName": "甲苯" },
      "expected_behavior": "DATABASE_HIT",
      "expected_conclusion": {
        "is_compliant": null,
        "expected_regulation_number": "GB 30000.7",
        "regulation": "GB 30000.7 易燃液体,类别2"
      },
      "expected_relevant_docs": ["GB 30000.7", "甲苯"]
    },
    {
      "id": "BL02",
      "category": "危险类别查询",
      "difficulty": "L1",
      "intent": "info_query",
      "query": "氢氧化钠的GHS分类是什么？",
      "expected_tool": "CheckHazardCategory",
      "expected_params": { "chemicalName": "氢氧化钠" },
      "expected_behavior": "DATABASE_HIT",
      "expected_conclusion": {
        "is_compliant": null,
        "expected_regulation_number": "GB 30000.17",
        "regulation": "GB 30000.17 金属腐蚀物,类别1; GB 30000.19 皮肤腐蚀/刺激,类别1A"
      },
      "expected_relevant_docs": ["GB 30000.17", "GB 30000.19", "氢氧化钠"]
    },
    {
      "id": "BL03",
      "category": "安全距离",
      "difficulty": "L1",
      "intent": "info_query",
      "query": "甲类仓库与明火点之间应保持多少米的安全间距？",
      "expected_tool": "GetSafetyDistance",
      "expected_params": { "facilityType": "甲类仓库-明火点" },
      "expected_behavior": "DATABASE_HIT",
      "expected_conclusion": {
        "regulation": "GB50160 ≥30m",
        "expected_regulation_number": "GB50160",
        "expected_distance": 30,
        "expected_distance_unit": "m"
      },
      "expected_relevant_docs": ["GB50160", "甲类仓库", "安全距离"]
    },
    {
      "id": "BL04",
      "category": "重大危险源查询",
      "difficulty": "L1",
      "intent": "info_query",
      "query": "氯气的重大危险源临界量是多少吨？",
