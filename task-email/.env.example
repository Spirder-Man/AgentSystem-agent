# ============================================
# Task Email MCP — 环境变量配置
# ============================================
# 复制此文件为 .env 并填入实际值

# ── SMTP 邮件配置 ──
# QQ邮箱: smtp.qq.com:587
# 163邮箱: smtp.163.com:465
# 授权码获取: QQ邮箱 → 设置 → 账户 → POP3/SMTP服务 → 生成授权码
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=your_email@qq.com
SMTP_PASS=your_smtp_authorization_code
SMTP_TO=your_email@qq.com

# ── HTTP 回调服务 ──
# 用户点击邮件按钮后打开的地址
# 本地开发: http://localhost:9876
# 如果需要从外网访问（如手机查看邮件），可改为公网地址
CALLBACK_PORT=9876
CALLBACK_HOST=http://localhost:9876
