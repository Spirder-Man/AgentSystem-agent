# ==========================================
# Agent1 - 化工合规 AI 平台环境变量配置模板
# 使用方式: cp .env.example .env 然后填入真实值
# ==========================================

# ═══════════════════════════════════════
# PostgreSQL 数据库连接（必填）
# ═══════════════════════════════════════
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chemical_park_ai_agent
DB_USERNAME=postgres
DB_PASSWORD=7758521

# ═══════════════════════════════════════
# JWT 签名密钥（生产必填，至少 32 字符）
# ═══════════════════════════════════════
JWT_KEY=qazwsxedcrfvtgbyhnujmikolpqazwsx

# ═══════════════════════════════════════
# 账号配置（JSON 数组，密码支持明文或 BCrypt 哈希）
# ═══════════════════════════════════════
AUTH_ACCOUNTS_JSON=[{"Username":"admin","Password":"7758521","Role":"admin"},{"Username":"auditor","Password":"7758521","Role":"auditor"}]

# ═══════════════════════════════════════
# 服务端口（可选，注释则用默认值）
# ═══════════════════════════════════════
# API_PORT=8080
# LLAMA_PORT=8080          # llama.cpp LLM 推理端口
# LLAMA_EMBED_PORT=8081    # llama.cpp Embedding 端口
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000

# ═══════════════════════════════════════
# 运行时环境
# ═══════════════════════════════════════
# ASPNETCORE_ENVIRONMENT=Production
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ═══════════════════════════════════════
# LLM 端点 (P0-2: 覆盖 appsettings.json)
# Docker 内自动设为 http://llama-server:8080/v1
# 裸机 llama.cpp 部署: http://localhost:8080/v1
# 裸机 Ollama 部署:   http://localhost:11434
# ═══════════════════════════════════════
# LLM_ENDPOINT=http://localhost:8080/v1

# ═══════════════════════════════════════
# 知识库路径 (P0-1: 跨平台覆盖)
# Docker 内自动设为 /app/knowledgebase
# ═══════════════════════════════════════
# KNOWLEDGE_BASE_PATH=/app/knowledgebase

# ═══════════════════════════════════════
# 告警邮件 SMTP 配置（生产必填）
# ═══════════════════════════════════════
# QQ邮箱授权码（设置→账户→POP3/SMTP服务→生成授权码）
ALERT_EMAIL_PASSWORD=你的QQ邮箱授权码
# 收件人列表，多个用逗号分隔
ALERT_RECIPIENT_EMAILS=admin@example.com

# ═══════════════════════════════════════
# OpenTelemetry (可选，分布式追踪)
# ═══════════════════════════════════════
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ═══════════════════════════════════════
# Grafana 管理员账号（可选）
# ═══════════════════════════════════════
# GRAFANA_USER=admin
# GRAFANA_PASSWORD=agent1-admin

# ═══════════════════════════════════════
# 集成测试数据库连接（本地开发 + CI 共用）
# 本地跑集成测试前确保 PostgreSQL 已启动:
#   dotnet test --filter "Category=Integration"
# ═══════════════════════════════════════
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=chemical_park_ai_agent
# DB_USERNAME=postgres
# DB_PASSWORD=7758521
# ==========================================
# AgentSystem - 环境变量配置模板
# 使用方式：复制为 .env 后填入真实值
#   cp .env.example .env
# ==========================================

# PostgreSQL 数据库连接（必填）
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chemical_park_ai_agent
DB_USERNAME=postgres
DB_PASSWORD=7758521

# JWT 签名密钥（生产必填，至少 32 字符）
JWT_KEY=qazwsxedcrfvtgbyhnujmikolpqazwsx

# 账号配置（生产必填，JSON 数组格式，密码支持明文或 BCrypt 哈希）
# 示例: [{"Username":"admin","Password":"你的密码","Role":"admin"},{"Username":"auditor","Password":"你的密码","Role":"auditor"}]
AUTH_ACCOUNTS_JSON=[{"Username":"admin","Password":"7758521","Role":"admin"},{"Username":"auditor","Password":"7758521","Role":"auditor"}]


# 以下配置在 appsettings.json 中已有默认值，
# 如需覆盖可通过环境变量设置（取消注释并填入值即可）
# ASPNETCORE_ENVIRONMENT=Production
# OLLAMA_PORT=11434
# API_PORT=8080
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ═══════════════════════════════════════
# 告警邮件 SMTP 配置（生产必填）
# ═══════════════════════════════════════
# QQ邮箱授权码（设置→账户→POP3/SMTP服务→生成授权码）
ALERT_EMAIL_PASSWORD=你的QQ邮箱授权码
# 收件人列表，多个用逗号分隔
ALERT_RECIPIENT_EMAILS=admin@example.com
