# ==========================================
# AgentSystem - 环境变量配置模板
# 使用方式：复制为 .env 后填入真实值
#   cp .env.example .env
# ==========================================

# PostgreSQL 数据库连接（必填）
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chemical_park_ai_agent
DB_USERNAME=postgres
DB_PASSWORD=7758521

# JWT 签名密钥（生产必填，至少 32 字符）
JWT_KEY=qazwsxedcrfvtgbyhnujmikolpqazwsx

# 账号配置（生产必填，JSON 数组格式，密码支持明文或 BCrypt 哈希）
# 示例: [{"Username":"admin","Password":"你的密码","Role":"admin"},{"Username":"auditor","Password":"你的密码","Role":"auditor"}]
AUTH_ACCOUNTS_JSON=[{"Username":"admin","Password":"7758521","Role":"admin"},{"Username":"auditor","Password":"7758521","Role":"auditor"}]


# 以下配置在 appsettings.json 中已有默认值，
# 如需覆盖可通过环境变量设置（取消注释并填入值即可）
# ASPNETCORE_ENVIRONMENT=Production
# LLM_ENDPOINT=http://localhost:11434
# LLM_MODEL_ID=qwen3:8b
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
