# Qwen3 8B 评测优化版 — CPU 推理加速
# 基于 qwen3:8b，仅覆盖性能参数，TEMPLATE 继承自原模型

FROM qwen3:8b

# 上下文窗口：4096
# 评测 prompt 简短且无对话历史，4096 足够容纳 tool definitions + prompt + RAG 结果
# 更大的 ctx 会显著增加 KV-cache 计算量，在 CPU 上反而拖慢推理
PARAMETER num_ctx 4096

# Prompt 批处理大小：512
# CPU 推理下 512 是 batch size 的安全值，1024 容易导致内存压力→超时
PARAMETER num_batch 512

# 线程数：使用物理核心数（i7-13620H = 6P+4E，留 4 线程给系统）
PARAMETER num_thread 12

