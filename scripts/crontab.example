# ============================================================
# Agent1 远程服务器 Cron 配置示例
#
# 定位：Post-deployment 质量监控（定时执行，不阻断服务）
# 原则：告警式 — 退化通知人工判断，不回滚
#
# 用法：
#   1. 修改下方 PROJECT_DIR 为实际项目路径
#   2. 确保 ADMIN_PWD 环境变量已设置（或通过 .env 加载）
#   3. crontab -e  然后粘贴以下内容
# ============================================================

# ⚠️ 部署前必须修改为实际路径！
PROJECT_DIR=/root/autodl-tmp/agent-system
LOG_DIR=${PROJECT_DIR}/eval_reports/cron_logs
mkdir -p ${LOG_DIR}

# ── 每日凌晨3点：全量64条合规评测跑分 ──
# Step 1-4: 跑分 + 基线对比 + 幻觉检测 + 汇总
# Step 5-7: 日志切片 + 六维度分析 (D1-D6) 
# 输出 eval_reports/YYYYMMDD_HHMM/summary.json
#      eval_reports/YYYYMMDD_HHMM/analysis.md
0 3 * * * ADMIN_PWD=123456789 bash ${PROJECT_DIR}/scripts/post-deploy-eval.sh >> ${LOG_DIR}/post-deploy-$(date +\%Y\%m\%d).log 2>&1 && ADMIN_PWD=123456789 bash ${PROJECT_DIR}/scripts/post-deploy-analyze.sh >> ${LOG_DIR}/analyze-$(date +\%Y\%m\%d).log 2>&1

# ── 每周一凌晨4点：老化清理（保留最近30份） ──
0 4 * * 1 find ${PROJECT_DIR}/eval_reports/ -maxdepth 1 -type d -name "202*" -mtime +30 -exec rm -rf {} \;

# ── 每小时：心跳监控 ──
0 * * * * curl -sf http://localhost:5000/health/live -o /dev/null || echo "$(date): FAIL" >> ${LOG_DIR}/heartbeat.log
