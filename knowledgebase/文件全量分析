## 🏗️ 第三部分：新数据库架构设计

### 设计目标

1. **文档-分块双层模型**：文件级元数据与 chunk 级内容分离
2. **完整元数据持久化**：14 个字段全部入库，快速模式不降级
3. **支持增量更新**：按文件粒度的增/删/改，不重建全量索引
4. **regulation_type 正确映射**：5 种类型独立标识
5. **向后兼容**：现有检索接口不破坏

### 表结构设计

```sql
-- ============================================================================
-- 知识库文档表（一个物理文件 = 一行）
-- ============================================================================
CREATE TABLE knowledge_documents (
    id              SERIAL PRIMARY KEY,
    
    -- 文件来源
    source_path     VARCHAR(500) NOT NULL UNIQUE,  -- 相对路径 "化工专业条例/化工专业条例/GB 30000.7-2013.pdf"
    file_name       VARCHAR(300) NOT NULL,          -- 展示名 "GB 30000.7-2013 化学品分类和标签规范 第7部分"
    file_format     VARCHAR(10)  NOT NULL,          -- pdf / doc / docx / txt
    file_size_bytes BIGINT,
    
    -- 法规属性
    regulation_type VARCHAR(50)  NOT NULL,          -- 国标 / 园区规则 / 历史案例 / 企业制度 / 化工专业条例
    regulation_number VARCHAR(100),                 -- "GB 30000.7-2013"
    regulation_title  VARCHAR(500),                 -- "化学品分类和标签规范 第7部分：易燃液体"
    priority        VARCHAR(10)  NOT NULL DEFAULT '中',  -- 高/中/低
    
    -- H166 层级（仅企业制度类文件使用）
    parent_category VARCHAR(200),                   -- "1.法律法规/1.1识别和获取"
    
    -- 质量标记
    extraction_quality VARCHAR(20) DEFAULT 'good',  -- good / partial / failed
    page_count      INT,
    is_full_text    BOOLEAN DEFAULT TRUE,           -- false=仅文件名摘要入库
    total_chunks    INT DEFAULT 0,
    
    -- 变更追踪
    content_hash    VARCHAR(64),                    -- SHA-256，用于增量检测
    last_modified   TIMESTAMP WITH TIME ZONE,
    created_at      TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- ============================================================================
-- 知识库分块表（一个语义块 = 一行 + 向量）
-- ============================================================================
CREATE TABLE knowledge_chunks (
    id              SERIAL PRIMARY KEY,
    document_id     INT NOT NULL REFERENCES knowledge_documents(id) ON DELETE CASCADE,
    
    -- 内容与向量
    content         TEXT NOT NULL,
    embedding       vector(768),
    
    -- 结构定位（从 SemanticChunker / ChunkByGbStructure 产出）
    chunk_index     INT NOT NULL DEFAULT 0,         -- 同文档内块序号
    chapter_number  VARCHAR(50),                    -- "3" 或 "第3章"
    chapter_title   VARCHAR(500),                   -- "术语和定义"
    clause_number   VARCHAR(50),                    -- "3.1", "3.2.1"
    article_number  VARCHAR(50),                    -- "第五条" (园区规则用)
    page_number     INT,
    sub_chunk_index INT,                            -- 章节内再分块的子序号
    
    -- 冗余（加速过滤，避免 JOIN）
    regulation_type VARCHAR(50)  NOT NULL,
    priority        VARCHAR(10)  NOT NULL,
    
    created_at      TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- ═══ 索引 ═══
-- 向量索引
CREATE INDEX idx_chunks_embedding ON knowledge_chunks 
    USING hnsw (embedding vector_cosine_ops) 
    WITH (m = 16, ef_construction = 200);

-- 过滤加速
CREATE INDEX idx_chunks_document_id    ON knowledge_chunks(document_id);
CREATE INDEX idx_chunks_regulation_type ON knowledge_chunks(regulation_type);
CREATE INDEX idx_chunks_priority       ON knowledge_chunks(priority);
CREATE INDEX idx_chunks_clause         ON knowledge_chunks(regulation_type, clause_number);
CREATE INDEX idx_docs_regulation_number ON knowledge_documents(regulation_number);
CREATE INDEX idx_docs_type_priority     ON knowledge_documents(regulation_type, priority);
```

